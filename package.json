{
  "name": "sekai-pass",
  "version": "1.0.0",
  "description": "SEKAI Pass - Modern SSO Single Sign-On System built with Cloudflare Workers, supporting OAuth 2.1 and OpenID Connect. Licensed under Apache-2.0.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "type-check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "sync-docs": "node scripts/sync-docs.js",
    "migrate": "node scripts/migrate.mjs"
  },
  "keywords": [
    "sso",
    "single-sign-on",
    "oauth2",
    "oauth2.1",
    "oidc",
    "openid-connect",
    "cloudflare-workers",
    "cloudflare",
    "lucia-auth",
    "authentication",
    "authorization",
    "pkce",
    "jwt",
    "d1-database",
    "hono",
    "edge-computing"
  ],
  "author": "The 25-ji-code-de Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/25-ji-code-de/sekai-pass.git"
  },
  "homepage": "https://github.com/25-ji-code-de/sekai-pass#readme",
  "bugs": {
    "url": "https://github.com/25-ji-code-de/sekai-pass/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "jose": "^6.2.8",
    "lucia": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.115.0"
  }
}
