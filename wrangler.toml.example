# wrangler.toml — 由 Workers Builds 构建时自动渲染（${VAR} 从 Dashboard 环境变量注入）
# 本地开发：复制此文件为 wrangler.toml，手动填入真实值
#
# 需要在 Cloudflare Dashboard 配置以下环境变量：
#   TURNSTILE_SITE_KEY   — Turnstile site key
#   HCAPTCHA_SITE_KEY    — hCaptcha site key（仅注册页使用）
#   D1_DATABASE_ID       — sekai_pass_db 的 database ID
#   KV_NAMESPACE_ID      — OIDC_KEYS KV namespace ID
#   KV_PREVIEW_ID        — OIDC_KEYS preview KV namespace ID
# 真正的 secret（TURNSTILE_SECRET_KEY 等）通过 `wrangler secret` 管理，不在此文件中

name = "sekai-pass"
main = "src/index.ts"
compatibility_date = "2026-02-10"
compatibility_flags = ["nodejs_compat"]

[vars]
ENVIRONMENT = "production"
TURNSTILE_SITE_KEY = "${TURNSTILE_SITE_KEY}"
HCAPTCHA_SITE_KEY = "${HCAPTCHA_SITE_KEY}"

# Static assets configuration
[assets]
directory = "public"
binding = "ASSETS"
not_found_handling = "single-page-application"

[[d1_databases]]
binding = "DB"
database_name = "sekai_pass_db"
database_id = "${D1_DATABASE_ID}"

# KV namespace for signing key cache
[[kv_namespaces]]
binding = "KV"
id = "${KV_NAMESPACE_ID}"
preview_id = "${KV_PREVIEW_ID}"

# Cron trigger for key rotation (weekly on Sunday at midnight)
[triggers]
crons = ["0 0 * * SUN"]
